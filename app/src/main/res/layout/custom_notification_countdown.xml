<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- ALARM COUNTDOWN SECTION -->
    <ImageView
        android:id="@+id/alarmIcon"
        android:layout_width="@dimen/notification_icon_size"
        android:layout_height="@dimen/notification_icon_size"
        android:src="@drawable/ic_bell"
        android:tint="@color/notification_text"
        android:layout_marginEnd="@dimen/notification_icon_spacer"
        tools:ignore="UseAppTint"
        android:contentDescription="@null" />

    <!-- Notifier.java relies on the child views being #0 (Chronometer) and #1 (TextView) in
         both ViewFlippers. -->
    <ViewFlipper
        android:id="@+id/countdownViewFlipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/notification_chronometer_spacer"
        android:layout_gravity="center_vertical"
        android:measureAllChildren="false">

        <Chronometer
            android:id="@+id/countdownChronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:ellipsize="end"
            android:gravity="bottom|left"
            android:layout_gravity="bottom|left"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:textColor="@color/notification_text"
            android:textStyle="bold"
            android:typeface="sans" />

        <TextView
            android:id="@+id/pausedCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="bottom|left"
            android:layout_gravity="bottom|left"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:textColor="@color/notification_text"
            android:textStyle="bold"
            android:typeface="sans" />
    </ViewFlipper>

</LinearLayout>
