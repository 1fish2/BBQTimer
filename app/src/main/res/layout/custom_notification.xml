<?xml version="1.0" encoding="utf-8"?>
<!-- This layout is used in RemoteViews so it can't reliably access theme attributes `?attr/`.
     The negative margins squeeze it a little so the heads-up notification
     doesn't clip the Pause & Play action buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="-2sp"
    android:layout_marginTop="-2sp"
    android:orientation="vertical"
    tools:viewBindingIgnore="true"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <!-- ELAPSED TIME SECTION -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_clock"
            android:tint="@color/notification_text"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />

        <!-- Notifier.java relies on the child views being #0 (Chronometer) and #1 (TextView) in
             both of these ViewFlippers. -->
        <ViewFlipper
            android:id="@+id/countUpViewFlipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:measureAllChildren="false">

            <Chronometer
                android:id="@+id/countUpChronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="bottom|left"
                android:layout_gravity="bottom|left"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/notification_text"
                android:textStyle="bold"
                android:typeface="sans" />

            <TextView
                android:id="@+id/pausedCountUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="bottom|left"
                android:layout_gravity="bottom|left"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/notification_text"
                android:textStyle="bold"
                android:typeface="sans" />
        </ViewFlipper>

        <!-- ALARM COUNTDOWN SECTION -->
        <ImageView
            android:id="@+id/alarmIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bell"
            android:tint="@color/notification_text"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginLeft="@dimen/notification_spacer"
            android:layout_marginStart="@dimen/notification_spacer"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />

        <ViewFlipper
            android:id="@+id/countdownViewFlipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:measureAllChildren="false">

            <Chronometer
                android:id="@+id/countdownChronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:ellipsize="end"
                android:gravity="bottom|left"
                android:layout_gravity="bottom|left"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/notification_text"
                android:typeface="sans" />

            <TextView
                android:id="@+id/pausedCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="bottom|left"
                android:layout_gravity="bottom|left"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/notification_text"
                android:typeface="sans" />
        </ViewFlipper>

        <TextView
            android:id="@+id/timerStateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/notification_spacer"
            android:layout_marginStart="@dimen/notification_spacer"
            android:maxLines="1"
            android:ellipsize="end"
            android:hyphenationFrequency="full"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:textColor="@color/notification_text" />

    </LinearLayout>

    <!-- ACTION BUTTONS SECTION -->
    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="left"
        android:paddingTop="0dp">

        <!-- TODO: Make these the size of the info icons, 16dp, using vector graphics. -->
        <ImageButton
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/notification_button_spacer"
            android:src="@drawable/ic_action_play"
            android:contentDescription="@string/start"
            android:background="@drawable/notification_button_background"
            android:scaleType="centerInside"
            android:tint="@color/notification_action_tint"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/notification_button_spacer"
            android:src="@drawable/ic_action_pause"
            android:contentDescription="@string/pause"
            android:background="@drawable/notification_button_background"
            android:scaleType="centerInside"
            android:tint="@color/notification_action_tint"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/notification_button_spacer"
            android:src="@drawable/ic_action_stop"
            android:contentDescription="@string/stop"
            android:background="@drawable/notification_button_background"
            android:scaleType="centerInside"
            android:tint="@color/notification_action_tint"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/notification_button_spacer"
            android:src="@drawable/ic_action_replay"
            android:contentDescription="@string/reset"
            android:background="@drawable/notification_button_background"
            android:scaleType="centerInside"
            android:tint="@color/notification_action_tint"
            tools:ignore="UseAppTint" />

    </LinearLayout>
</LinearLayout>
